# Neon connection string. On Vercel use the POOLED one (host contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Teams Workflows webhook URL. Leave empty to run in dry-run mode
# (the Teams Preview page still shows what would be sent).
TEAMS_WEBHOOK_URL=""

# Random string; Vercel Cron sends it as a Bearer token to /api/cron/reminders.
CRON_SECRET="change-me-to-a-long-random-string"

# Optional: puts the site behind a simple password prompt until Entra ID is added.
APP_PASSWORD=""

# Public URL used for links inside the Teams message. On Vercel this falls back
# to the production domain automatically.
APP_URL="http://localhost:3000"

# Business time zone used to decide what "today" is.
APP_TIMEZONE="America/New_York"
